# WINGS dev container configuration. Copy to `.env` and adjust.
# Every value below is a default — uncomment and change only what you need.

# Match the wings version your app pins in go.mod (used to install the dev tool).
WINGS_VERSION=v0.16.1-alpha

# ---- dev server -------------------------------------------------------------
WINGS_PORT=8080            # dev server port (also published by docker-compose)
WINGS_WEBROOT=.            # dir holding index.html; wings.wasm + JS helpers land here
WINGS_MAIN=.              # main package compiled to wasm (relative to the app root)

# Custom server command. Empty = the built-in static server. When set, this runs
# once (cwd = app root) instead of the built-in server; build+watch keep running.
# Example: WINGS_HTTPD=go run ./server
WINGS_HTTPD=

# ---- i18n (optional) --------------------------------------------------------
WINGS_DEFLANG=            # e.g. pt-BR — if set, runs gen_i18n each build; empty = skip
WINGS_I18N_PATH=          # dir gen_i18n scans (default = WINGS_MAIN); its /i18n is published to the webroot
WINGS_GENI18N_ARGS=       # extra gen_i18n flags (e.g. catalog signing keys)

# ---- i18n: inflection dictionaries (auto-flex) ------------------------------
# Unitex dictionaries baked into the image AT BUILD TIME. Compiling Unitex pulls
# a C++ toolchain into a throwaway build stage (slow first build); the final
# image only carries the resulting <lang>.db files. Empty = no dictionaries.
WINGS_DICT_LANGS=         # build arg: comma list, e.g. pt-BR,en-US
WINGS_AUTO_FLEX=          # 1 = pass -auto-flex (fill inflections from the dicts)
WINGS_DICT_DIR=/opt/wings/dicts   # where the baked .db live (matches the image)

# ---- i18n: machine/LLM translation (auto-translate) -------------------------
# Pre-fills empty catalog entries via a backend, flagged for human review.
# These synthesize a gen_i18n.json — but only if your app does NOT already have
# one (a hand-authored gen_i18n.json always wins).
WINGS_AUTO_TRANSLATE=     # 1 = pass -auto-translate
WINGS_TR_BACKEND=         # openai | libretranslate
WINGS_TR_URL=             # backend endpoint (LibreTranslate or OpenAI-compatible)
WINGS_TR_MODEL=           # model name (openai backend only)
WINGS_TR_KEY=             # API key (if the backend needs one)
WINGS_TR_TIMEOUT=60s      # per-call timeout

# ---- build / watch ----------------------------------------------------------
WINGS_BUILD_TAGS=         # extra -tags for `go build`
WINGS_WATCH_EXT=go,html,css,json   # file extensions that trigger a rebuild
WINGS_DEBOUNCE_MS=200     # coalesce window (ms) for rapid saves

# ---- recipe: the bundled live-demo ------------------------------------------
# Copy the wings `live-demo/` and `docs/` folders next to these files, then use:
#   WINGS_WEBROOT=./docs
#   WINGS_MAIN=./live-demo
#   WINGS_I18N_PATH=./live-demo/mod
#   WINGS_DEFLANG=pt-BR
#   WINGS_BUILD_TAGS=wings_test
#   WINGS_GENI18N_ARGS=-sign-key ./live-demo/gen_i18n.ed25519.key -sign-key-password wings-live-demo
