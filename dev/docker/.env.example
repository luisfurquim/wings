# WINGS dev container configuration. Copy to `.env` and adjust.
# Every value below is a default; change only what you need.
#
# IMPORTANT: comments live on their OWN lines. Do not append `# ...` after a
# value — docker compose reads an inline comment on an empty value AS the value
# (so `WINGS_DICT_LANGS=  # …` becomes a non-empty string, not empty).

# Match the wings version your app pins in go.mod (used to install the dev tool).
WINGS_VERSION=v0.16.2-alpha

# ---- dev server -------------------------------------------------------------

# Dev server port (also published by docker-compose).
WINGS_PORT=8080

# Dir holding index.html; wings.wasm + JS helpers land here.
WINGS_WEBROOT=.

# Main package compiled to wasm (relative to the app root).
WINGS_MAIN=.

# Custom server command. Empty = the built-in static server. When set, this runs
# once (cwd = app root) instead of the built-in server; build+watch keep running.
# Example: WINGS_HTTPD=go run ./server
WINGS_HTTPD=

# ---- i18n (optional) --------------------------------------------------------

# e.g. pt-BR — if set, runs gen_i18n each build; empty = skip.
WINGS_DEFLANG=

# Dir gen_i18n scans (default = WINGS_MAIN); its /i18n is published to the webroot.
WINGS_I18N_PATH=

# Extra gen_i18n flags (e.g. catalog signing keys).
WINGS_GENI18N_ARGS=

# ---- i18n: inflection dictionaries (auto-flex) ------------------------------
# Unitex dictionaries baked into the image AT BUILD TIME. Compiling Unitex pulls
# a C++ toolchain into a throwaway build stage (slow first build); the final
# image only carries the resulting <lang>.db files. Empty = no dictionaries.
# Use LANGUAGE tags, not region tags: `en` (not en-US), `es` (not es-AR); only
# `pt` splits into pt-BR / pt-PT.

# Build arg: comma list, e.g. pt-BR,en,es
WINGS_DICT_LANGS=

# Set to 1 to pass -auto-flex (fill inflections from the dicts).
WINGS_AUTO_FLEX=

# Where the baked .db live (matches the image).
WINGS_DICT_DIR=/opt/wings/dicts

# ---- i18n: machine/LLM translation (auto-translate) -------------------------
# Pre-fills empty catalog entries via a backend, flagged for human review.
# These synthesize a gen_i18n.json — but only if your app does NOT already have
# one (a hand-authored gen_i18n.json always wins).

# Set to 1 to pass -auto-translate.
WINGS_AUTO_TRANSLATE=

# openai | libretranslate
WINGS_TR_BACKEND=

# Backend endpoint (LibreTranslate or OpenAI-compatible).
WINGS_TR_URL=

# Model name (openai backend only).
WINGS_TR_MODEL=

# API key (if the backend needs one).
WINGS_TR_KEY=

# Per-call timeout.
WINGS_TR_TIMEOUT=60s

# ---- build / watch ----------------------------------------------------------

# Extra -tags for `go build`.
WINGS_BUILD_TAGS=

# File extensions that trigger a rebuild.
WINGS_WATCH_EXT=go,html,css,json

# Coalesce window (ms) for rapid saves.
WINGS_DEBOUNCE_MS=200

# ---- recipe: the bundled live-demo ------------------------------------------
# Copy the wings `live-demo/` and `docs/` folders next to these files, then set:
#   WINGS_WEBROOT=./docs
#   WINGS_MAIN=./live-demo
#   WINGS_I18N_PATH=mod
#   WINGS_DEFLANG=pt-BR
#   WINGS_BUILD_TAGS=wings_test
#   WINGS_GENI18N_ARGS=-sign-key ./gen_i18n.ed25519.key -sign-key-password wings-live-demo
# (WINGS_I18N_PATH and the -sign-key path are relative to WINGS_MAIN, the module dir.)
# Leave WINGS_DICT_LANGS empty — the live-demo ships pre-computed inflections.
