go 1.25.0

// Local development of wings together with its sub-modules. This replaces the
// per-module `replace … => ../` directives: the override now lives here, at the
// repo root, so it does NOT travel when a sub-module (e.g. live-demo) is copied
// out — a copied module resolves wings from the proxy via its `require` instead.
use (
	.
	./example
	./helpers/wlate
	./live-demo
)
