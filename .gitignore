work/
.gitignore
.claude

# Dictionary binaries (generated by dictbuild, cached locally)
cmd/dictbuild/dicts/
# gen_i18n pre-compiled dicts (.db files downloaded/built by dictbuild)
cmd/gen_i18n/dicts/*.db
# dictbuild auto-fetch state (cloned unitex-core, built tools, cached .bin/.inf)
cmd/dictbuild/tool/
cmd/dictbuild/cache/
# Keep the gen_i18n hash database (per-project translation index stability)
!**/i18n.db

# Compiled binaries (built at repo root or inside their cmd/ directory)
/gen_i18n
/dictbuild
cmd/gen_i18n/gen_i18n
cmd/dictbuild/dictbuild
helpers/wlate/serve
