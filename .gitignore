work/
.gitignore
# Ignore Claude Code local state, but version the skills (security practices
# distilled into .claude/skills/*/SKILL.md). Contents-with-negation form
# (.claude/* + !) because git can't re-include inside a fully excluded dir.
.claude/*
!.claude/skills/

# Local-dev workspace file: overrides wings + sub-modules with the on-disk tree
# (replaces per-module `replace` directives). It must NOT be published — the Go
# proxy packs it into the module zip, where its `./example`, `./helpers/wlate`,
# `./live-demo` entries point at sub-modules excluded from the zip, breaking any
# downstream `go build` that runs inside the cached wings dir (e.g. gen_i18n).
go.work
go.work.sum

# Dictionary binaries (generated by dictbuild, cached locally)
cmd/dictbuild/dicts/
# gen_i18n pre-compiled dicts (.db files downloaded/built by dictbuild)
cmd/gen_i18n/dicts/*.db
# dictbuild auto-fetch state (cloned unitex-core, built tools, cached .bin/.inf)
cmd/dictbuild/tool/
cmd/dictbuild/cache/
# Legacy gen_i18n write-only artifact. No longer produced (change detection now
# runs off the committed i18n/*.json catalogs); ignored so any stale file left
# by an older build is never tracked.
**/i18n.db

# Compiled binaries (built at repo root or inside their cmd/ directory)
/gen_i18n
/dictbuild
cmd/gen_i18n/gen_i18n
cmd/dictbuild/dictbuild
helpers/wlate/serve
# Stray binary from `go build ./cmd/build` (the build orchestrator; run it with
# `go run ./cmd/build <target>` instead).
/build
cmd/build/build
# WASM binaries from ad-hoc `go build` (build.sh uses -o, so these are stray)
example/example
helpers/wlate/wlate
live-demo/live-demo
